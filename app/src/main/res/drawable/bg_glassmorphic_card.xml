<?xml version="1.0" encoding="utf-8"?>
<!-- Glassmorphism Container with rounded corners and ultra-thin white borders -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1AFFFFFF"> <!-- Ripple feedback on click -->
    <item>
        <shape android:shape="rectangle">
            <!-- 10% translucent white background for glass blur backing -->
            <solid android:color="@color/glass_white_fill" />
            
            <!-- 15dp Rounded Corners for modern card styling -->
            <corners android:radius="15dp" />
            
            <!-- Thin border to simulate glass thickness -->
            <stroke
                android:width="1dp"
                android:color="@color/glass_white_border" />
        </shape>
    </item>
</ripple>
